# 服务配置
APP_PORT=3000

# 日志配置
# 日志级别: log | error | warn | debug | verbose
# - log:   一般信息（默认）
# - error: 仅错误
# - warn:  警告及以上
# - debug: 调试及以上（包含所有）
# - verbose: 最详细（包含所有）
LOG_LEVEL=log

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=wx_nest
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_TIMEZONE=+08:00

# JWT 配置
JWT_ACCESS_SECRET=your-secret-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRATION=7d

# Swagger 配置
SWAGGER_ENABLED=true

# 微信小程序（code2session 登录 + 订阅消息 access_token）
WX_APP_ID=
WX_APP_SECRET=
# 可选：本地调测登录后门，设置后 /auth/login 跳过 code2session
#WX_MOCK_OPENID=dev_mock_openid
# 可选：覆盖微信 API 地址（默认 https://api.weixin.qq.com）
#WX_WX_API_BASE=https://api.weixin.qq.com

# Redis 配置（存微信 access_token）
REDIS_HOST=localhost
REDIS_PORT=6379
#REDIS_PASSWORD=
#REDIS_DB=0
#REDIS_KEY_PREFIX=wx-nest:

# 腾讯云 COS 临时密钥（STS）配置
COS_SECRET_ID=
COS_SECRET_KEY=
# 允许上传的路径前缀（默认 uploads/*）
COS_ALLOW_PREFIX=uploads/*
# 临时密钥有效期（秒，默认 1800）
COS_STS_DURATION=1800
