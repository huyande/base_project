.page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  padding: 48rpx;
  box-sizing: border-box;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
}

.desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #8e8e93;
}

.start-btn {
  margin-top: 96rpx;
  width: 80%;
  background: #58cc02;
  color: #ffffff;
  border-radius: 48rpx;
}
