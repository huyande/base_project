.home-button {
  position: fixed;
  z-index: var(--z-fixed);
  top: calc(env(safe-area-inset-top) + 16rpx);
  left: var(--page-margin);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: var(--border-radius-round);
  background: rgba(255, 255, 255, 0.38);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  box-shadow: var(--shadow-sm);
  -webkit-backdrop-filter: blur(20rpx);
  backdrop-filter: blur(20rpx);
  transition: opacity var(--transition-fast), transform var(--transition-fast);
}

@supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
  .home-button {
    background: rgba(255, 255, 255, 0.22);
  }
}

.home-button--active {
  opacity: 0.7;
  transform: scale(0.96);
}

.home-button__icon {
  width: 36rpx;
  height: 36rpx;
  -webkit-mask: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cpath fill-rule='evenodd' d='M12 3.172L3 10.5V21a1 1 0 0 0 1 1h5v-6h6v6h5a1 1 0 0 0 1-1V10.5L12 3.172zM4.5 11.25L12 5.25l7.5 6V20h-3.5v-6a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6H4.5v-8.75z'/%3E%3C/svg%3E") no-repeat 50% 50%;
  mask: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cpath fill-rule='evenodd' d='M12 3.172L3 10.5V21a1 1 0 0 0 1 1h5v-6h6v6h5a1 1 0 0 0 1-1V10.5L12 3.172zM4.5 11.25L12 5.25l7.5 6V20h-3.5v-6a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6H4.5v-8.75z'/%3E%3C/svg%3E") no-repeat 50% 50%;
  -webkit-mask-size: contain;
  mask-size: contain;
  background-color: var(--text-primary);
}

@media (prefers-reduced-motion: reduce) {
  .home-button {
    transition: none;
  }
}
